{
  "specVersion": "0.1",
  "rules": [
    {
      "effect": "allow",
      "category": "network",
      "action": "use_credential",
      "target": {
        "type": "http_request",
        "credentialId": "github",
        "scheme": "https",
        "host": "report.demo.test",
        "path": "/v1/ping",
        "methods": [
          "GET"
        ],
        "responseRewrite": "buffered"
      }
    },
    {
      "effect": "allow",
      "category": "network",
      "action": "use_credential",
      "target": {
        "type": "http_request",
        "credentialId": "github",
        "scheme": "https",
        "host": "report.demo.test",
        "path": "/v1/reports",
        "methods": [
          "POST"
        ],
        "responseRewrite": "buffered"
      }
    }
  ]
}
