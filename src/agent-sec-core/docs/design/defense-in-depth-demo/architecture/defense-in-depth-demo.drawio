        </mxCell>
        <mxCell id="host" value="&lt;span style=&quot;font-size:20px&quot;&gt;&lt;b&gt;宿主机（Host）｜防护组件、真密钥与测试上游均位于 Sandbox 外&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=2;fontColor=#172033;fontFamily=Noto Sans CJK SC;fontSize=22;spacing=10;swimlane;startSize=40;container=1;pointerEvents=0;collapsible=0;align=left;spacingLeft=20;swimlaneFillColor=#fbfcfe;" vertex="1" parent="1">
