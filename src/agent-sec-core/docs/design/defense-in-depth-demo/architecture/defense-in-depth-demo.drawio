        <mxCell id="admin" value="&lt;b&gt;Host 管理员 CLI&lt;/b&gt;&lt;br&gt;创建／完整查询策略&lt;br&gt;配置与启动环境" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;strokeWidth=2;fontColor=#172033;fontFamily=Noto Sans CJK SC;fontSize=19;spacing=10;" vertex="1" parent="host">
          <mxGeometry as="geometry" x="40" y="80" width="220" height="120" />
        </mxCell>
        <mxCell id="daemon" value="&lt;b&gt;SecCore daemon（root）&lt;/b&gt;&lt;br&gt;Sandbox 基线：Cedar · 启动授权&lt;br&gt;文件保护：Cedar&lt;br&gt;凭据用途：JSON" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;strokeWidth=2;fontColor=#172033;fontFamily=Noto Sans CJK SC;fontSize=20;spacing=10;" vertex="1" parent="host">
          <mxGeometry as="geometry" x="320" y="65" width="450" height="150" />
        </mxCell>
        <mxCell id="binding" value="&lt;b&gt;Scope → 发现进程 → 两个 Binding&lt;/b&gt;&lt;br&gt;processName=qodercli · ownerUid=1001&lt;br&gt;只引用文件策略和凭据策略&lt;br&gt;两项 READY 后，才发送第一条任务" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;strokeWidth=2;fontColor=#172033;fontFamily=Noto Sans CJK SC;fontSize=19;spacing=10;" vertex="1" parent="host">
          <mxGeometry as="geometry" x="880" y="65" width="490" height="150" />
        </mxCell>
        <mxCell id="pep" value="&lt;b&gt;启动入口 authorized_sandbox&lt;/b&gt;&lt;br&gt;调用 PDP 授权 → 安装 Sandbox → 启动 Qoder" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;strokeWidth=2;fontColor=#172033;fontFamily=Noto Sans CJK SC;fontSize=19;spacing=10;" vertex="1" parent="host">
          <mxGeometry as="geometry" x="320" y="260" width="450" height="110" />
        </mxCell>
        <mxCell id="sight" value="&lt;b&gt;② AgentSight（root）&lt;/b&gt;&lt;br&gt;在内核执行文件保护&lt;br&gt;覆盖 Qoder 及本次工具后代" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;strokeWidth=2;fontColor=#172033;fontFamily=Noto Sans CJK SC;fontSize=18;spacing=10;" vertex="1" parent="host">
          <mxGeometry as="geometry" x="880" y="270" width="300" height="105" />
        </mxCell>
