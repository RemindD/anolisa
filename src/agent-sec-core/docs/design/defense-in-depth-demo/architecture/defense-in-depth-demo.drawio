  <diagram id="formal-demo-architecture" name="当前 Demo 架构">
    <mxGraphModel dx="1880" dy="1230" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1900" pageHeight="1230" background="#ffffff">
