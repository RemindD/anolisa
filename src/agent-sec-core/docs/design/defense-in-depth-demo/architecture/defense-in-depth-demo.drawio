        </mxCell>
        <mxCell id="subtitle" value="formal-7jmaa8br · 同一 Qoder 会话 · 13 项实机验证 · 管理配置在 Host，业务操作由 Sandbox 内的 Agent 发起" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#475569;align=left;verticalAlign=middle;" vertex="1" parent="1">
