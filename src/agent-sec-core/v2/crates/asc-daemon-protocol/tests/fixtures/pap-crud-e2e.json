{
  "schemaVersion": 1,
  "dynamicValues": {
    "request_id": "a fresh UUID returned by the daemon for each response",
    "policy_id": "the UUID returned by create Policy and reused by later steps",
    "scope_id": "the UUID returned by create Scope and reused by later steps"
  },
  "objects": {
    "policyV1": {
      "policyId": "${policy_id}",
      "policyName": "protect-important-files-v1",
      "revision": 1,
      "template": {
        "kind": "prevent_file_deletion",
        "files": [
          "/workspace/important/**",
          "/etc/agent/config.yaml"
        ]
      },
      "canonicalPolicy": {
        "irSchemaVersion": 1,
        "profileId": "agentseccore-canonical-ir/v1alpha1-demo1",
        "policyId": "${policy_id}",
        "revision": 1,
        "payload": {
          "resources": [
            {
              "id": "protected-file-entries",
              "kind": "file",
              "matchers": [
                {
                  "path": {
                    "type": "glob",
                    "pattern": "/workspace/important/**"
                  },
                  "resolution": {
                    "type": "path_entry"
                  }
                },
                {
                  "path": {
                    "type": "exact",
                    "path": "/etc/agent/config.yaml"
                  },
                  "resolution": {
                    "type": "path_entry"
                  }
                }
              ]
            }
          ],
          "rules": [
            {
              "id": "deny-protected-file-deletion",
              "when": {
                "type": "atom",
                "atom": {
                  "type": "resource_operation",
                  "operation": "delete",
                  "target": {
                    "type": "in",
                    "resourceSet": "protected-file-entries"
                  }
                }
              },
              "outcome": {
                "decision": "deny",
                "obligations": [
                  "audit",
                  "emit_receipt"
                ],
                "remediation": "none"
              },
              "enforcement": {
                "decisionTiming": "pre_effect",
                "requiredEvidence": [
                  "binding_ready",
                  "operation_denied"
                ]
              }
            }
          ],
          "activation": "post_attach_allowed",
          "failurePolicy": {
            "runtime": "fail_closed",
            "update": "keep_last_known_good"
          }
        }
      }
    },
    "policyV2": {
      "policyId": "${policy_id}",
      "policyName": "protect-important-files-v2",
      "revision": 2,
      "template": {
        "kind": "prevent_file_deletion",
        "files": [
          "/srv/data"
        ]
      },
      "canonicalPolicy": {
        "irSchemaVersion": 1,
        "profileId": "agentseccore-canonical-ir/v1alpha1-demo1",
        "policyId": "${policy_id}",
        "revision": 2,
        "payload": {
          "resources": [
            {
              "id": "protected-file-entries",
              "kind": "file",
              "matchers": [
                {
                  "path": {
                    "type": "exact",
                    "path": "/srv/data"
                  },
                  "resolution": {
                    "type": "path_entry"
                  }
                }
              ]
            }
          ],
          "rules": [
            {
              "id": "deny-protected-file-deletion",
              "when": {
                "type": "atom",
                "atom": {
                  "type": "resource_operation",
                  "operation": "delete",
                  "target": {
                    "type": "in",
                    "resourceSet": "protected-file-entries"
                  }
                }
              },
              "outcome": {
                "decision": "deny",
                "obligations": [
                  "audit",
                  "emit_receipt"
                ],
                "remediation": "none"
              },
              "enforcement": {
                "decisionTiming": "pre_effect",
                "requiredEvidence": [
                  "binding_ready",
                  "operation_denied"
                ]
              }
            }
          ],
          "activation": "post_attach_allowed",
          "failurePolicy": {
            "runtime": "fail_closed",
            "update": "keep_last_known_good"
          }
        }
      }
    },
    "scopeV1": {
      "scopeId": "${scope_id}",
      "selector": {
        "kind": "process",
        "match": {
          "processName": "no-such-agent"
        }
      },
      "policySnapshots": [
        {
          "$ref": "policyV1"
        }
      ],
      "status": "ACTIVE"
    }
  },
  "steps": [
    {
      "name": "create-policy",
      "request": {
        "method": "policy.templates.create",
        "params": {
          "policyName": "protect-important-files-v1",
          "template": {
            "kind": "prevent_file_deletion",
            "files": [
              "/workspace/important/**",
              "/etc/agent/config.yaml"
            ]
          }
        }
      },
      "captures": [
        {
          "name": "policy_id",
          "pointer": "/result/policyId",
          "format": "uuid"
        }
      ],
      "expectedResponse": {
        "requestId": "${request_id}",
        "result": {
          "$ref": "policyV1"
        }
      }
    },
    {
      "name": "create-scope",
      "request": {
        "method": "policy.scopes.create",
        "params": {
          "selector": {
            "kind": "process",
            "match": {
              "processName": "no-such-agent"
            }
          },
          "policyTemplates": [
            {
              "policyId": "${policy_id}",
              "policyRevision": 1
            }
          ]
        }
      },
      "captures": [
        {
          "name": "scope_id",
          "pointer": "/result/scopeId",
          "format": "uuid"
        }
      ],
      "expectedResponse": {
        "requestId": "${request_id}",
        "result": {
          "$ref": "scopeV1"
        }
      }
    },
    {
      "name": "update-policy",
      "request": {
        "method": "policy.templates.update",
        "params": {
          "policyId": "${policy_id}",
          "policyName": "protect-important-files-v2",
          "template": {
            "kind": "prevent_file_deletion",
            "files": [
              "/srv/data"
            ]
          }
        }
      },
      "captures": [],
      "expectedResponse": {
        "requestId": "${request_id}",
        "result": {
          "$ref": "policyV2"
        }
      }
    },
    {
      "name": "get-policy",
      "request": {
        "method": "policy.templates.get",
        "params": {
          "id": "${policy_id}",
          "revision": 2
        }
      },
      "captures": [],
      "expectedResponse": {
        "requestId": "${request_id}",
        "result": {
          "$ref": "policyV2"
        }
      }
    },
    {
      "name": "list-policies",
      "request": {
        "method": "policy.templates.list",
        "params": {
          "limit": 10,
          "offset": 0
        }
      },
      "captures": [],
      "expectedResponse": {
        "requestId": "${request_id}",
        "result": {
          "items": [
            {
              "$ref": "policyV2"
            }
          ],
          "total": 1
        }
      }
    },
    {
      "name": "get-scope",
      "request": {
        "method": "policy.scopes.get",
        "params": {
          "id": "${scope_id}"
        }
      },
      "captures": [],
      "expectedResponse": {
        "requestId": "${request_id}",
        "result": {
          "$ref": "scopeV1"
        }
      }
    },
    {
      "name": "list-scopes",
      "request": {
        "method": "policy.scopes.list",
        "params": {
          "limit": 10,
          "offset": 0
        }
      },
      "captures": [],
      "expectedResponse": {
        "requestId": "${request_id}",
        "result": {
          "items": [
            {
              "$ref": "scopeV1"
            }
          ],
          "total": 1
        }
      }
    },
    {
      "name": "list-bindings",
      "request": {
        "method": "policy.bindings.list",
        "params": {
          "limit": 10,
          "offset": 0
        }
      },
      "captures": [],
      "expectedResponse": {
        "requestId": "${request_id}",
        "result": {
          "items": [],
          "total": 0
        }
      }
    },
    {
      "name": "delete-policy",
      "request": {
        "method": "policy.templates.delete",
        "params": {
          "id": "${policy_id}",
          "revision": 2
        }
      },
      "captures": [],
      "expectedResponse": {
        "requestId": "${request_id}",
        "result": {
          "$ref": "policyV2"
        }
      }
    },
    {
      "name": "retry-scope",
      "request": {
        "method": "policy.scopes.retry",
        "params": {
          "id": "${scope_id}"
        }
      },
      "captures": [],
      "expectedResponse": {
        "requestId": "${request_id}",
        "result": {
          "$ref": "scopeV1"
        }
      }
    },
    {
      "name": "delete-scope",
      "request": {
        "method": "policy.scopes.delete",
        "params": {
          "id": "${scope_id}"
        }
      },
      "captures": [],
      "expectedResponse": {
        "requestId": "${request_id}",
        "result": {
          "scopeId": "${scope_id}",
          "completed": true
        }
      }
    }
  ]
}
